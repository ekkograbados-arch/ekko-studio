{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    }
  ],
  "functions": {
    "api/products.js": {
      "includeFiles": "ASSETS/mockups-medidas/**"
    },
    "api/fonts.js": {
      "includeFiles": "ASSETS/fonts/**"
    },
    "api/synapse.js": {
      "includeFiles": "ASSETS/**"
    }
  }
}
