{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "credentialless" }
      ]
    }
  ],
  "functions": {
    "api/products.js": {
      "includeFiles": "ASSETS/mockups-medidas/**/*"
    },
    "api/fonts.js": {
      "includeFiles": "ASSETS/fonts/**/*"
    },
    "api/synapse.js": {
      "includeFiles": "ASSETS/**/*"
    },
    "api/repo-scanner.js": {
      "includeFiles": "ASSETS/**/*"
    },
    "api/payload-scanner.js": {
      "includeFiles": "ASSETS/**/*"
    }
  },
  "cleanUrls": true,
  "trailingSlash": false
}
